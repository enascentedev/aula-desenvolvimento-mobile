# Normaliza finais de linha: o repositório guarda sempre LF.
* text=auto eol=lf

# Scripts que PRECISAM de LF para funcionar em Linux/macOS.
gradlew text eol=lf

# Scripts que precisam de CRLF para funcionar no Windows.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binários: nunca converter.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pptx binary
*.pdf binary
*.jar binary
*.apk binary
*.keystore binary
